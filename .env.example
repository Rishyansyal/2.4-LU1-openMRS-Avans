# Copy this file to .env and replace all secrets before starting OpenMRS.
OMRS_DB_USER=openmrs
OMRS_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Must match the backend hospital configuration.
OPENMRS_WEBHOOK_SECRET=
OPENMRS_WEBHOOK_ORGANIZATION_ID=hospital-a

# Optional overrides.
OPENMRS_WEBHOOK_BACKEND_URL=http://host.docker.internal:5111/api/webhooks/openmrs/appointments
OPENMRS_WEBHOOK_OUTBOX_PATH=/openmrs/data/openmrs-webhook-outbox.jsonl
OPENMRS_WEBHOOK_RETRY_INTERVAL_MS=300000
